rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMessMember(messId) {
      return signedIn()
        && exists(/databases/$(database)/documents/messes/$(messId))
        && request.auth.uid in get(/databases/$(database)/documents/messes/$(messId)).data.memberUids;
    }
    function isMessOwner(messId) {
      return isMessMember(messId)
        && get(/databases/$(database)/documents/messes/$(messId)).data.ownerUid == request.auth.uid;
    }

    match /messInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.messId is string
        && existsAfter(/databases/$(database)/documents/messes/$(request.resource.data.messId))
        && getAfter(/databases/$(database)/documents/messes/$(request.resource.data.messId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/messes/$(request.resource.data.messId)).data.inviteCode == inviteCode;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
      match /personalTransactions/{transactionId} {
        allow read, create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
      }
      match /loans/{loanId} {
        allow read, create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
        match /repayments/{repaymentId} {
          allow read, create: if signedIn() && request.auth.uid == uid;
          allow update, delete: if false;
        }
      }
    }

    match /messes/{messId} {
      allow read: if isMessMember(messId);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.inviteCode is string;
      allow update: if (isMessOwner(messId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'defaultSplitStrategy', 'updatedAt']))
        || (signedIn()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && get(/databases/$(database)/documents/messInvites/$(resource.data.inviteCode)).data.messId == messId
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']));
      allow delete: if isMessOwner(messId);

      match /members/{memberUid} {
        allow read: if isMessMember(messId);
        allow create, update: if signedIn()
          && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && (isMessMember(messId)
            || (existsAfter(/databases/$(database)/documents/messes/$(messId))
              && request.auth.uid in getAfter(/databases/$(database)/documents/messes/$(messId)).data.memberUids));
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.paidByUid == request.auth.uid
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.kind in ['deposit', 'messExpense', 'memberPaidExpense']
          && request.resource.data.memberUidsAtPosting is list
          && request.auth.uid in request.resource.data.memberUidsAtPosting
          && get(/databases/$(database)/documents/messes/$(messId)).data.memberUids.hasAll(request.resource.data.memberUidsAtPosting)
          && request.resource.data.transactionDate is timestamp
          && request.resource.data.status == 'posted'
          && request.resource.data.splitStrategy == get(/databases/$(database)/documents/messes/$(messId)).data.get('defaultSplitStrategy', 'equal')
          && request.resource.data.mealEligible is bool;
        allow update, delete: if false;
      }

      match /monthClosures/{monthKey} {
        allow read: if isMessMember(messId);
        allow create: if isMessOwner(messId)
          && request.resource.data.monthKey == monthKey
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.balanceSnapshot is map
          && request.resource.data.totalMeals is int
          && request.resource.data.mealEligibleExpenseMinor is int
          && request.resource.data.incomeMinor is int
          && request.resource.data.expenseMinor is int;
        allow update, delete: if false;
      }

      match /meals/{mealId} {
        allow read: if isMessMember(messId);
        allow create, update: if isMessMember(messId)
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 20
          && request.resource.data.dateKey is string
          && mealId == request.auth.uid + '_' + request.resource.data.dateKey;
        allow delete: if false;
      }
    }
  }
}
